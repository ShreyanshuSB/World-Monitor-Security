# ==============================================================================
# Security Assessment Platform - Environment Configuration (.env.example)
# NTRO SIH26163 - World Monitor Application Assessment
# ==============================================================================

# Target Environment (Must be localhost/127.0.0.1 - Fail closed)
WM_TARGET_URL=http://127.0.0.1:8001
LAB_PORT=8001
API_PORT=8000
DASHBOARD_PORT=5173

# Scope Guard Enforcement (FAIL_CLOSED)
SCOPE_GUARD_ENABLED=true
ALLOWED_HOSTS=localhost,127.0.0.1,::1

# Platform Security Secrets
JWT_SECRET_KEY=replace_with_a_strong_random_secret_min_32_chars
OPERATOR_ID=sec_lead_auditor

# SQLite Database Paths
LAB_DATABASE_URL=sqlite:///lab/lab.db
PLATFORM_DATABASE_URL=sqlite:///engine/assessment.db
